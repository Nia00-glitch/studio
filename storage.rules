rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Incident recordings can only be written by the user who created the incident.
    // They can only be read by that user or a user with an 'admin' role.
    match /incidents/{incidentId}/{allPaths=**} {
      allow write: if request.auth != null && request.auth.uid == incidentId.split('-')[0];
      allow read: if request.auth != null && (request.auth.uid == incidentId.split('-')[0] || request.auth.token.role == 'admin');
    }

    // Default deny all other access to storage.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
