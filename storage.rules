
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Secure user recordings:
    // Users can only write to a folder that matches their own user ID.
    // This prevents one user from accessing or overwriting another user's data.
    match /recordings/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
