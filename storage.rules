
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Only the user who owns the incident can write recordings to their folder.
    // Admins or investigators could be granted read access.
    match /incidents/{incidentId}/{allPaths=**} {
      allow write: if request.auth != null && exists(/databases/$(database)/documents/incidents/$(incidentId)) &&
                   request.auth.uid == get(/databases/$(database)/documents/incidents/$(incidentId)).data.userId;
      allow read: if request.auth != null && (
                    (exists(/databases/$(database)/documents/incidents/$(incidentId)) && 
                     request.auth.uid == get(/databases/$(database)/documents/incidents/$(incidentId)).data.userId) ||
                     request.auth.token.role == 'admin'
                  );
    }
  }
}
