rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Default deny all access to prevent unauthorized file access.
    match /{allPaths=**} {
      allow read, write: if false;
    }
    
    // USER PROFILE IMAGES (Example)
    // Allow users to read/write their own profile picture.
    match /users/{userId}/profile.jpg {
      allow read: if true; // Publicly readable profile pictures
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // INCIDENT RECORDINGS
    // These are highly sensitive and should have strict rules.
    // - Only the user who created the incident can write files to their incident folder.
    // - Only the user and designated admins/responders should be able to read.
    match /incidents/{incidentId}/{fileName} {
      // Write access is granted to the user who owns the incident.
      // We would typically verify ownership by checking an associated Firestore document.
      // For simplicity here, we assume a naming convention where the incidentId starts with the userId.
      allow write: if request.auth != null && incidentId.startsWith(request.auth.uid);
      
      // Read access is restricted to the owner and users with an 'admin' custom claim.
      allow read: if request.auth != null && (incidentId.startsWith(request.auth.uid) || request.auth.token.role == 'admin');
    }
  }
}
