rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection
    match /users/{userId} {
      allow create: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid == userId;
    }

    // Rides: structured state transitions validation
    match /rides/{rideId} {
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.riderId
                    && request.resource.data.status == 'pending'
                    && request.resource.data.requestedAt == request.time;
      allow read: if request.auth != null;
      allow update: if request.auth != null && (
        // Rider can cancel their own ride before accepted
        (request.auth.uid == resource.data.riderId
         && request.resource.data.status in ['cancelled']
         && resource.data.status == 'pending')
        ||
        // Driver can accept if they are verified driver and ride still pending
        (request.auth.token.role == 'driver' 
         && request.resource.data.driverId == request.auth.uid
         && resource.data.status == 'pending'
         && request.resource.data.status == 'accepted')
        ||
        // Allow server side transitions via Cloud Functions (if function uses admin SDK, it bypasses rules)
        false
      );
    }

    // Drivers collection for driver metadata
    match /drivers/{driverId} {
      allow read: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid == driverId;
      allow create: if request.auth != null && request.auth.uid == driverId;
    }

    // Incidents (SOS)
    match /incidents/{incidentId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.userId ||
        request.auth.token.role == 'admin' ||
        request.auth.token.role == 'investigator'
      );
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.userId ||
        request.auth.token.role == 'admin'
      );
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
