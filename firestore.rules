rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read/write their own profile.
    match /users/{userId} {
      allow read, update: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null;
    }

    // Drivers can write their location. Any authenticated user can read driver locations.
    match /driver_locations/{driverId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == driverId;
    }

    // Rides have complex rules for state transitions.
    match /rides/{rideId} {
      allow read: if request.auth != null;

      // A user can only create a ride for themselves.
      allow create: if request.auth != null && request.auth.uid == request.resource.data.riderId;
      
      allow update: if request.auth != null && (
        // A rider can cancel their own ride ONLY if it's pending.
        (request.auth.uid == resource.data.riderId && 
         request.resource.data.status == 'cancelled' && 
         resource.data.status == 'pending')
        ||
        // An assigned driver can update the live location or mark it as in-progress/completed.
        (request.auth.uid == resource.data.driverId && 
         (request.resource.data.status == 'in-progress' || request.resource.data.status == 'completed' || request.resource.data.keys().hasAny(['driverLive'])))
        ||
        // A driver (with a verified custom claim) can accept a ride.
        // This is mainly handled by the transactional Cloud Function, but this rule provides a backup.
        (request.auth.token.role == 'driver' && 
         request.resource.data.driverId == request.auth.uid &&
         resource.data.status == 'pending')
      );
    }

    // Incidents can be created by any authenticated user.
    // Only the user who created it or an admin can update/read it.
    match /incidents/{incidentId} {
        allow create: if request.auth != null;
        allow read, update: if request.auth != null && (request.auth.uid == resource.data.userId || request.auth.token.role == 'admin');
    }

    // Default deny all other access.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
