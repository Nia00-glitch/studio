
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only read and write their own profile data.
    match /users/{userId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null;
    }

    // Drivers can only create or update their own location document.
    match /driver_locations/{driverId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null && request.auth.uid == driverId;
    }

    // Rides have more complex rules for different states.
    match /rides/{rideId} {
      // Anyone authenticated can read ride data (e.g., for map display) but this could be tightened.
      allow read: if request.auth != null;

      // A rider can create a ride for themselves.
      allow create: if request.auth != null && request.resource.data.riderId == request.auth.uid;

      // Rules for updating a ride document.
      allow update: if request.auth != null && (
        // A rider can cancel their own ride if it's pending or accepted.
        (
          request.resource.data.riderId == request.auth.uid &&
          resource.data.status in ['pending', 'accepted'] &&
          request.resource.data.status == 'cancelled'
        ) ||
        // The assigned driver can update the ride status (e.g., accept, start, complete).
        (
          request.auth.uid == resource.data.driverId &&
          request.resource.data.status in ['in-progress', 'completed']
        ) ||
        // A driver can accept a ride assigned to them if it's still pending.
        // This transaction is also protected by the Cloud Function's logic.
        (
            request.auth.uid == request.resource.data.notifiedDriverId &&
            resource.data.status == 'pending' &&
            request.resource.data.status == 'accepted'
        )
      );
    }
  }
}
