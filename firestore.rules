
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    function isDriver() {
      return request.auth.token.role == 'driver';
    }
    function isRider() {
      return request.auth.token.role == 'rider';
    }
    
    // Users can only read/write their own profile.
    match /users/{userId} {
      allow read, update: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn();
    }

    // Drivers can write their location if they are marked as a driver.
    match /driver_locations/{driverId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && isOwner(driverId) && isDriver();
    }

    // Rides have more complex rules for state transitions.
    match /rides/{rideId} {
      allow read: if isSignedIn();
      
      // Rider can create a ride for themselves.
      allow create: if isSignedIn() && isRider() && isOwner(request.resource.data.riderId);
      
      allow update: if isSignedIn() && (
        // Rider can cancel their own ride if it is pending.
        (isOwner(resource.data.riderId) && request.resource.data.status == 'cancelled' && resource.data.status == 'pending') ||
        // Assigned driver can update ride status to in-progress or completed
        (isOwner(resource.data.driverId) && (request.resource.data.status in ['in-progress', 'completed'])) ||
        // Server-side logic can update declinedBy array or status to 'no_drivers_available'
        (request.resource.data.keys().hasAny(['declinedBy', 'notifiedDriverId', 'status']))
      );
    }
    
    // Incidents can be created by any authenticated user.
    // Read/update is restricted to the owner or an admin.
    match /incidents/{incidentId} {
      allow create: if isSignedIn();
      allow read, update: if isSignedIn() && (isOwner(resource.data.userId) || request.auth.token.role == 'admin');
    }
  }
}
