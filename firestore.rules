
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only read and write their own profile data.
    match /users/{userId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null;
    }

    // Drivers can only write their own location data.
    // Any authenticated user can read driver locations to see them on the map.
    match /driver_locations/{driverId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == driverId;
    }

    // Rules for the 'rides' collection
    match /rides/{rideId} {
      
      // CREATE: A rider can create a ride request for themselves.
      allow create: if request.auth != null 
                    && request.resource.data.riderId == request.auth.uid
                    && request.resource.data.status == 'pending';

      // READ: The rider and the assigned driver can read the ride document.
      allow read: if request.auth != null
                  && (request.auth.uid == resource.data.riderId || request.auth.uid == resource.data.driverId);

      // UPDATE: Handles the ride lifecycle securely.
      allow update: if request.auth != null && (
        
        // CASE 1: Driver accepts a pending ride.
        // - The user must be the notified driver.
        // - The ride must be in 'pending' status.
        // - The update can only change status to 'accepted' and set the driverId.
        (
          request.auth.uid == resource.data.notifiedDriverId
          && resource.data.status == 'pending'
          && request.resource.data.status == 'accepted'
          && request.resource.data.driverId == request.auth.uid
          && request.resource.data.riderId == resource.data.riderId // Rider cannot be changed
        ) ||

        // CASE 2: Driver declines a pending ride.
        // - The user must be the notified driver.
        // - The ride must be 'pending'.
        // - The update only adds the driver to the 'declinedBy' list.
        (
          request.auth.uid == resource.data.notifiedDriverId
          && resource.data.status == 'pending'
          && request.resource.data.declinedBy == resource.data.declinedBy.concat([request.auth.uid])
        ) ||
        
        // CASE 3: Assigned driver updates an 'accepted' ride (e.g., to 'in-progress' or 'completed').
        (
          request.auth.uid == resource.data.driverId
          && resource.data.status == 'accepted'
          && (request.resource.data.status == 'in-progress' || request.resource.data.status == 'completed')
        ) ||
        
        // CASE 4: Rider cancels their own ride.
        // - The user must be the original rider.
        // - The ride can be cancelled if it's 'pending' or 'accepted'.
        (
          request.auth.uid == resource.data.riderId
          && (resource.data.status == 'pending' || resource.data.status == 'accepted')
          && request.resource.data.status == 'cancelled'
        )
      );
      
      // DELETE: Rides should not be deletable, only moved to a final state like 'completed' or 'cancelled'.
      allow delete: if false;
    }
  }
}
