rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only read/write their own profile.
    match /users/{userId} {
      allow read, update: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null;
    }

    // Drivers can write their location. Any authenticated user can read driver locations.
    match /driver_locations/{driverId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == driverId;
    }

    // Rides have more complex rules for state transitions.
    match /rides/{rideId} {
      allow read: if request.auth != null;

      // Rider can create their own ride.
      allow create: if request.auth != null && request.auth.uid == request.resource.data.riderId;

      // Update rules
      allow update: if request.auth != null && (
        // Rider can cancel their own ride if it's pending.
        (request.auth.uid == resource.data.riderId &&
         request.resource.data.status == 'cancelled' &&
         resource.data.status == 'pending')
        ||
        // Driver can complete their assigned ride.
        (request.auth.uid == resource.data.driverId &&
         request.resource.data.status == 'completed' &&
         resource.data.status == 'in-progress')
        ||
        // Driver can cancel their assigned ride.
        (request.auth.uid == resource.data.driverId &&
         request.resource.data.status == 'cancelled')
      );
    }
    
    // Incidents can be created by any auth'd user. Only they or an admin can read/update.
    match /incidents/{incidentId} {
        allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
        allow read, update: if request.auth != null && (request.auth.uid == resource.data.userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }
  }
}
